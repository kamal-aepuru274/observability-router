{
  "name": "@temporalio-observability/router",
  "version": "1.0.0",
  "description": "Configuration facade that consistently attaches Temporal TypeScript Worker metrics to Prometheus (v1) and future OTLP backends.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "temporal",
    "observability",
    "prometheus",
    "metrics",
    "opentelemetry"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@temporalio/worker": ">=1.9.0 <2.0.0"
  },
  "devDependencies": {
    "@temporalio/worker": "^1.11.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
